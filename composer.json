{
    "name": "quebracho/x402",
    "description": "x402 payments for PHP: EIP-712/EIP-3009 signing, PSR-15 middleware and PSR-18 paying client.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-gmp": "*",
        "kornrunner/keccak": "^1.1",
        "kornrunner/secp256k1": "^0.4",
        "psr/http-server-middleware": "^1.0",
        "psr/http-factory": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "nyholm/psr7": "^1.8"
    },
    "autoload": { "psr-4": { "Quebracho\\X402\\": "src/" } },
    "autoload-dev": { "psr-4": { "Quebracho\\X402\\Tests\\": "tests/" } }
}
