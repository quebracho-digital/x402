{
    "name": "quebracho/x402",
    "description": "x402 payments for PHP: EIP-712/EIP-3009 signing, PSR-15 middleware and PSR-18 paying client.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-gmp": "*",
        "ext-sodium": "*",
        "kornrunner/keccak": "^1.1",
        "kornrunner/secp256k1": "^0.4",
        "psr/event-dispatcher": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-client": "^1.0",
        "paragonie/ecc": "^2.6",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/log": "^3",
        "psr/cache": "^3.0",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.3",
        "infection/infection": "^0.35",
        "friendsofphp/php-cs-fixer": "^3.95",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/http-client": "^7.3"
    },
    "suggest": {
        "ext-redis": "RedisLedger: one payment ledger for several hosts",
        "ext-posix": "Stop: checks that the flag file is owned by the user running PHP"
    },
    "autoload": {
        "psr-4": {
            "Quebracho\\X402\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quebracho\\X402\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress -c phpstan.dist.neon",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "deps": "composer-dependency-analyser",
        "check": [
            "@test",
            "@stan",
            "@cs",
            "@deps"
        ]
    }
}
